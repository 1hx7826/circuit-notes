{
  "name": "circuit-notes",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/prepare-content.mjs",
    "dev": "npm run content && vite --host 127.0.0.1 --port 5178 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "npm run content && vitest run",
    "build": "npm run content && npm run typecheck && vite build && node scripts/audit-dist.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 4178 --strictPort"
  },
  "dependencies": { "react": "19.3.0", "react-dom": "19.3.0", "react-markdown": "10.1.0", "remark-gfm": "4.0.1", "remark-math": "6.0.0", "rehype-katex": "7.0.1", "katex": "0.16.25" },
  "devDependencies": { "@types/react": "19.3.0", "@types/react-dom": "19.3.0", "@vitejs/plugin-react": "6.1.2", "typescript": "7.0.2", "vite": "8.3.4", "vitest": "5.0.4" }
}
